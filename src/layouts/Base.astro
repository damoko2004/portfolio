---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content, links, SITE_URL, type Lang } from '../data/content';

interface Props {
  lang: Lang;
  /** Titre et description spécifiques à la page. Par défaut, ceux de l'accueil. */
  title?: string;
  description?: string;
  /** Chemins de cette même page dans chaque langue, pour les balises hreflang. */
  altFr?: string;
  altEn?: string;
}

const { lang, title, description, altFr = '/', altEn = '/en/' } = Astro.props;
const t = content[lang];
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og.png', SITE_URL).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dikers Amoko',
  jobTitle: t.hero.title,
  description: t.meta.description,
  email: `mailto:${links.email}`,
  telephone: links.phone,
  url: SITE_URL,
  address: { '@type': 'PostalAddress', addressRegion: 'Île-de-France', addressCountry: 'FR' },
  knowsLanguage: ['fr', 'en'],
  sameAs: [links.linkedin, links.cran, links.github].filter(Boolean),
  knowsAbout: [
    'Data science',
    'Machine learning',
    'MLOps',
    'Generative AI',
    'RAG',
    'Product ownership',
    'Official statistics',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={`${SITE_URL}${altFr}`} />
    <link rel="alternate" hreflang="en" href={`${SITE_URL}${altEn}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${altFr}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0e2b28" />
    <meta name="author" content="Dikers Amoko" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Dikers Amoko" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header lang={lang} altFr={altFr} altEn={altEn} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
