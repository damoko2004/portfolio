---
import { content, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
---

<section class="chain" aria-label={t.chain.title}>
  <div class="wrap">
    <div class="chain__head">
      <h2>{t.chain.title}</h2>
      <p>{t.chain.note}</p>
    </div>

    <ol class="chain__list">
      {
        t.chain.stages.map((stage) => (
          <li>
            <span class="node" aria-hidden="true"></span>
            <h3>{stage.name}</h3>
            <p>{stage.desc}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .chain {
    background: var(--paper-2);
    border-bottom: 1px solid var(--rule);
    padding-block: var(--sp-5);
  }

  .chain__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
    padding-bottom: var(--sp-4);
  }

  .chain__head h2 {
    font-size: var(--t-lg);
  }

  .chain__head p {
    font-size: var(--t-sm);
    color: var(--ink-2);
    max-width: 46ch;
  }

  .chain__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    position: relative;
  }

  /* Le fil continu qui relie les étapes. */
  .chain__list::before {
    content: '';
    position: absolute;
    top: 0.3rem;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--rule-strong);
  }

  .chain__list li {
    position: relative;
    padding: var(--sp-4) var(--sp-3) 0 0;
  }

  .chain__list li + li {
    padding-left: var(--sp-3);
  }

  .node {
    position: absolute;
    top: 0;
    left: 0;
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid var(--gold);
    background: var(--paper-2);
    transform: rotate(45deg);
  }

  .chain__list li + li .node {
    left: var(--sp-3);
  }

  .chain__list li:first-child .node {
    background: var(--gold);
  }

  .chain__list h3 {
    font-size: var(--t-md);
    font-weight: 500;
  }

  .chain__list p {
    margin-top: 0.4rem;
    font-size: var(--t-sm);
    color: var(--ink-2);
    line-height: 1.5;
    max-width: 32ch;
  }

  @media (max-width: 62rem) {
    .chain__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--sp-4);
    }

    .chain__list::before {
      display: none;
    }

    .chain__list li {
      border-top: 1px solid var(--rule-strong);
    }
  }

  @media (max-width: 34rem) {
    .chain__list {
      grid-template-columns: 1fr;
    }

    .chain__list li + li {
      padding-left: 0;
    }

    .chain__list li + li .node {
      left: 0;
    }
  }
</style>
