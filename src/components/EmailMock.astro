---
// Reconstitution du livrable RTE avec des données SYNTHÉTIQUES.
// Les séries ci-dessous sont générées par un générateur pseudo-aléatoire à
// graine fixe, uniquement pour illustrer la forme du rendu. Elles n'ont aucun
// rapport avec des valeurs réelles et ne doivent jamais être remplacées par
// des valeurs réelles.

interface Block {
  title: string;
  note: string;
  kind: string;
}

interface Props {
  mock: {
    title: string;
    note: string;
    badge: string;
    subject: string;
    date: string;
    blocks: Block[];
    criteriaTitle: string;
    criteria: string[];
  };
}

const { mock } = Astro.props;

// Générateur à graine fixe : le rendu est identique à chaque build.
function makeRandom(seed: number) {
  let s = seed;
  return () => {
    s = (s * 1103515245 + 12345) % 2147483648;
    return s / 2147483648;
  };
}

const W = 640;
const H = 150;
const PAD = 8;

// Série « enveloppe + trajectoire du jour »
function bandChart() {
  const rand = makeRandom(20230426);
  const n = 48;
  const centre: number[] = [];
  let value = 0.55;
  for (let i = 0; i < n; i++) {
    value += (rand() - 0.5) * 0.08;
    value += (0.55 - value) * 0.12;
    centre.push(Math.min(0.9, Math.max(0.15, value)));
  }
  const x = (i: number) => PAD + (i * (W - 2 * PAD)) / (n - 1);
  const y = (v: number) => H - PAD - v * (H - 2 * PAD);
  const spread = 0.13;

  const upper = centre.map((v, i) => `${x(i)},${y(Math.min(0.97, v + spread))}`);
  const lower = centre.map((v, i) => `${x(i)},${y(Math.max(0.03, v - spread))}`).reverse();
  const area = `M${upper.join(' L')} L${lower.join(' L')} Z`;

  const rand2 = makeRandom(77);
  const today = centre.map((v) => v + (rand2() - 0.42) * 0.11);
  const line = today.map((v, i) => `${x(i)},${y(Math.min(1, Math.max(0, v)))}`).join(' ');

  return { area, line };
}

// Série de flux, positifs et négatifs autour d'un axe
function barChart() {
  const rand = makeRandom(4242);
  const n = 24;
  const values = Array.from({ length: n }, () => (rand() - 0.45) * 1.7);
  const mid = H / 2;
  const slot = (W - 2 * PAD) / n;
  const bars = values.map((v, i) => ({
    x: PAD + i * slot + slot * 0.18,
    w: slot * 0.64,
    y: v >= 0 ? mid - v * (mid - PAD) : mid,
    h: Math.max(1.5, Math.abs(v) * (mid - PAD)),
    up: v >= 0,
  }));
  return { bars, mid };
}

const band = bandChart();
const bar = barChart();
---

<section class="mock" aria-labelledby="mock-title">
  <div class="mock__head">
    <h2 id="mock-title">{mock.title}</h2>
    <p class="mock__note">{mock.note}</p>
  </div>

  <div class="frame">
    <p class="frame__badge">{mock.badge}</p>

    <div class="mail">
      <header class="mail__head">
        <p class="mail__subject">{mock.subject}</p>
        <p class="mail__date">{mock.date}</p>
      </header>

      {
        mock.blocks.map((block) => (
          <article class="mail__block">
            <h3>{block.title}</h3>

            {block.kind === 'status' && <p class="mail__status">{block.note}</p>}

            {block.kind === 'band' && (
              <>
                <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={block.title} class="chart">
                  <path d={band.area} class="chart__band" />
                  <polyline points={band.line} class="chart__line" />
                  <line x1={PAD} y1={H - PAD} x2={W - PAD} y2={H - PAD} class="chart__axis" />
                </svg>
                <p class="mail__caption">{block.note}</p>
              </>
            )}

            {block.kind === 'bars' && (
              <>
                <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={block.title} class="chart">
                  {bar.bars.map((b) => (
                    <rect
                      x={b.x}
                      y={b.y}
                      width={b.w}
                      height={b.h}
                      class={b.up ? 'chart__bar' : 'chart__bar chart__bar--down'}
                    />
                  ))}
                  <line x1={PAD} y1={bar.mid} x2={W - PAD} y2={bar.mid} class="chart__axis" />
                </svg>
                <p class="mail__caption">{block.note}</p>
              </>
            )}
          </article>
        ))
      }

      <footer class="mail__foot">
        <p class="mail__foot-title">{mock.criteriaTitle}</p>
        <ul>
          {mock.criteria.map((c) => <li>{c}</li>)}
        </ul>
      </footer>
    </div>
  </div>
</section>

<style>
  .mock {
    margin-top: var(--sp-5);
  }

  .mock__head h2 {
    font-size: var(--t-xl);
  }

  .mock__note {
    margin-top: var(--sp-2);
    max-width: var(--measure);
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .frame {
    position: relative;
    margin-top: var(--sp-3);
    background: var(--paper-2);
    border: 1px solid var(--rule-strong);
    padding: clamp(1rem, 3vw, 2rem);
  }

  .frame__badge {
    position: absolute;
    top: 0;
    right: 0;
    background: var(--gold);
    color: #fff;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.7rem;
  }

  .mail {
    background: #fff;
    border: 1px solid var(--rule);
    padding: clamp(0.9rem, 2.5vw, 1.6rem);
    max-width: 46rem;
  }

  .mail__head {
    padding-bottom: var(--sp-2);
    border-bottom: 2px solid var(--pine);
  }

  .mail__subject {
    font-family: var(--serif);
    font-size: var(--t-md);
    line-height: 1.25;
    color: var(--ink);
  }

  .mail__date {
    margin-top: 0.2rem;
    font-size: var(--t-xs);
    color: var(--ink-3);
  }

  .mail__block {
    padding-block: var(--sp-3);
    border-bottom: 1px solid var(--rule);
  }

  .mail__block h3 {
    font-family: var(--sans);
    font-size: var(--t-sm);
    font-weight: 620;
    line-height: 1.35;
  }

  .mail__status {
    margin-top: 0.5rem;
    font-size: var(--t-sm);
    color: var(--ink-2);
    border-left: 3px solid var(--rule-strong);
    padding-left: 0.7rem;
  }

  .mail__caption {
    margin-top: 0.4rem;
    font-size: var(--t-xs);
    color: var(--ink-3);
    line-height: 1.45;
  }

  .chart {
    margin-top: 0.7rem;
    width: 100%;
    height: auto;
  }

  .chart__band {
    fill: color-mix(in srgb, var(--pine) 12%, transparent);
  }

  .chart__line {
    fill: none;
    stroke: var(--pine);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .chart__bar {
    fill: var(--pine-mid);
  }

  .chart__bar--down {
    fill: var(--gold);
  }

  .chart__axis {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .mail__foot {
    padding-top: var(--sp-3);
  }

  .mail__foot-title {
    font-size: var(--t-xs);
    font-weight: 620;
    letter-spacing: 0.03em;
    color: var(--gold);
  }

  .mail__foot ul {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.3rem;
  }

  .mail__foot li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--t-xs);
    color: var(--ink-2);
    line-height: 1.5;
  }

  .mail__foot li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.4rem;
    height: 1px;
    background: var(--rule-strong);
  }
</style>
