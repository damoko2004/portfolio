---
import { withBase } from '../utils/url';
import { content, links, type Lang } from '../data/content';

interface Props {
  lang: Lang;
  altFr?: string;
  altEn?: string;
}
const { lang, altFr = '/', altEn = '/en/' } = Astro.props;
const t = content[lang];
const home = lang === 'fr' ? '/' : '/en/';
const cv = lang === 'fr' ? links.cvFr : links.cvEn;

// Sur une page interne, les ancres doivent repartir vers l'accueil.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const onHome = path === '/' || path === '/en';
const resolve = (href: string) =>
  href.startsWith('#') ? (onHome ? href : withBase(`${home}${href}`)) : withBase(href);

// La bascule FR/EN pointe vers l'équivalent de la page courante.
const otherHref = lang === 'fr' ? altEn : altFr;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href={withBase(home)}>
      <span class="mark__glyph" aria-hidden="true">DA</span>
      <span class="mark__name">Dikers Amoko</span>
    </a>

    <nav class="nav" aria-label={t.nav.menu}>
      <ul>
        {
          t.nav.items.map((item) => (
            <li>
              <a href={resolve(item.href)} data-navlink={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tail">
      <a class="lang" href={withBase(otherHref)} hreflang={lang === 'fr' ? 'en' : 'fr'}>
        {lang === 'fr' ? 'EN' : 'FR'}
      </a>
      {
        links.linkedin && (
          <a class="profil" href={links.linkedin} rel="noopener" target="_blank" title={t.nav.linkedin}>
            <span class="visually-hidden">{t.nav.linkedin}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.76-1.95C21.4 8.75 22 11.1 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2.05-3.3-2.05 0-2.37 1.57-2.37 3.2V21h-3.9V9z"
              />
            </svg>
          </a>
        )
      }
      {
        links.github && (
          <a class="profil" href={links.github} rel="noopener" target="_blank" title={t.nav.github}>
            <span class="visually-hidden">{t.nav.github}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.1c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"
              />
            </svg>
          </a>
        )
      }
      <a class="cv" href={withBase(cv)} download>{t.nav.cv}</a>
      <button
        class="burger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-burger
      >
        <span class="visually-hidden">{t.nav.menu}</span>
        <span class="burger__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav class="mobile" id="mobile-nav" hidden aria-label={t.nav.menu}>
    <ul>
      {
        t.nav.items.map((item) => (
          <li>
            <a href={resolve(item.href)}>{item.label}</a>
          </li>
        ))
      }
      <li>
        <a href={withBase(cv)} download>{t.nav.cv}</a>
      </li>
      {
        links.linkedin && (
          <li>
            <a href={links.linkedin} rel="noopener" target="_blank">
              {t.nav.linkedin}
            </a>
          </li>
        )
      }
      {
        links.github && (
          <li>
            <a href={links.github} rel="noopener" target="_blank">
              {t.nav.github}
            </a>
          </li>
        )
      }
    </ul>
  </nav>
</header>

<script>
  // --- Menu mobile ---------------------------------------------------------
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const panel = document.getElementById('mobile-nav');

  const setOpen = (open: boolean) => {
    if (!burger || !panel) return;
    burger.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    document.documentElement.classList.toggle('is-locked', open);
  };

  burger?.addEventListener('click', () => {
    setOpen(burger.getAttribute('aria-expanded') !== 'true');
  });

  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).tagName === 'A') setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  // --- Section active dans la navigation -----------------------------------
  const linkFor = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-navlink]').forEach((a) => {
    const id = a.dataset.navlink?.replace('#', '');
    if (id) linkFor.set(id, a);
  });

  const sections = [...linkFor.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = linkFor.get(entry.target.id);
          if (link) link.classList.toggle('is-current', entry.isIntersecting);
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style is:global>
  html.is-locked {
    overflow: hidden;
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule-pine);
    color: var(--on-pine);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 4rem;
  }

  .mark {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    margin-right: auto;
  }

  .mark__glyph {
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--gold-bright);
    border-bottom: 2px solid var(--gold-bright);
    line-height: 1.1;
  }

  .mark__name {
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--on-pine);
  }

  .nav ul {
    display: flex;
    gap: 1.05rem;
  }

  .nav a {
    font-size: var(--t-sm);
    font-weight: 420;
    color: var(--on-pine-2);
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .nav a:hover,
  .nav a.is-current {
    color: var(--on-pine);
    border-bottom-color: var(--gold-bright);
  }

  .tail {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .lang {
    font-size: var(--t-xs);
    font-weight: 620;
    letter-spacing: 0.06em;
    color: var(--on-pine-2);
    text-decoration: none;
    border: 1px solid var(--rule-pine);
    padding: 0.3rem 0.5rem;
    transition: color 0.15s, border-color 0.15s;
  }

  .lang:hover {
    color: var(--on-pine);
    border-color: var(--on-pine-2);
  }

  .profil {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    color: var(--ink-2);
    border: 1px solid var(--rule-strong);
    transition: color 0.15s, border-color 0.15s;
  }

  .profil svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .profil:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .cv {
    font-size: var(--t-xs);
    font-weight: 560;
    color: #fff;
    background: var(--gold);
    text-decoration: none;
    padding: 0.45rem 0.8rem;
    white-space: nowrap;
  }

  .cv:hover {
    background: #744c09;
  }

  .burger {
    display: none;
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    background: none;
    border: 1px solid var(--rule-pine);
    cursor: pointer;
    place-items: center;
  }

  .burger__bars,
  .burger__bars::before,
  .burger__bars::after {
    display: block;
    width: 1rem;
    height: 1px;
    background: var(--on-pine);
  }

  .burger__bars::before,
  .burger__bars::after {
    content: '';
    position: relative;
  }

  .burger__bars::before {
    top: -5px;
  }

  .burger__bars::after {
    top: 4px;
  }

  .burger[aria-expanded='true'] {
    border-color: var(--gold-bright);
  }

  .mobile {
    border-top: 1px solid var(--rule);
    background: var(--paper);
    padding: var(--sp-2) var(--gutter) var(--sp-3);
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
  }

  .mobile a {
    display: block;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule-pine);
    font-size: var(--t-md);
    color: var(--on-pine);
    text-decoration: none;
  }

  @media (max-width: 62rem) {
    .nav {
      display: none;
    }

    .burger {
      display: grid;
    }
  }

  @media (min-width: 62.01rem) {
    .mobile {
      display: none;
    }
  }

  @media (max-width: 48rem) {
    .profil {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .mark__name {
      display: none;
    }

    .cv {
      display: none;
    }
  }
</style>
